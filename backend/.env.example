# Copy this file to .env and adjust for your environment.
# .env is loaded automatically at startup (via python-dotenv) if present.
# Never commit a real .env file — it's already covered by .gitignore.

# Comma-separated list of frontend origins allowed to call this API.
# "*" (default) is fine for local development. In production, set this to
# your real deployed frontend origin(s), e.g.:
#   MEDVERIFY_CORS_ORIGINS=https://medverify.example.com
MEDVERIFY_CORS_ORIGINS=*

# Max accepted image upload size, in megabytes.
MEDVERIFY_MAX_UPLOAD_MB=8

# Rate limits for the public endpoints (requires slowapi; format: "N/minute" etc.)
MEDVERIFY_RATE_LIMIT_TEXT=30/minute
MEDVERIFY_RATE_LIMIT_IMAGE=10/minute

# "development" or "production"
MEDVERIFY_ENV=development

# Only needed if OCR fails with "tesseract is not installed or it's not in
# your PATH" even after installing Tesseract-OCR (common on Windows).
# Point this directly at the tesseract executable instead of relying on PATH.
# MEDVERIFY_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Optional: AI-assisted plain-language explanation of verification results
# (Groq — free API, fast open-source models). Get a free key at
# https://console.groq.com/keys (no credit card needed). Leave unset and
# this feature just stays "not available" — nothing else depends on it.
# GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_SECONDS=8
