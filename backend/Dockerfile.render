# Lean image for free-tier deployment (e.g. Render.com's free web service:
# 512MB RAM, limited build minutes). Differs from the local-dev Dockerfile:
#   - Uses requirements-render.txt (no TensorFlow — see that file for why)
#   - Bakes in backend/data/ directly (free tiers don't offer the kind of
#     persistent volume mounts docker-compose.yml uses for local dev)
#   - Listens on $PORT (Render assigns this dynamically, not a fixed port)
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    tesseract-ocr \
    libzbar0 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements-render.txt .
RUN pip install --no-cache-dir -r requirements-render.txt

# Bring in the app code and the data files it needs — everything required
# to run is inside the image, since there's no external volume on a free tier.
COPY app ./app
COPY data ./data

RUN mkdir -p /app/tmp_uploads

# Render sets $PORT itself; default to 8000 for any other platform that
# doesn't set it (e.g. running this image locally with `docker run`).
ENV PORT=8000
EXPOSE 8000

CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT}"]
