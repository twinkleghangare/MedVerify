# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
backend/venv/

# Environment / secrets
.env
*.env
!.env.example

# Runtime data
backend/tmp_uploads/
backend/app/models/weights/*.keras
backend/app/models/weights/*.txt

# Test / tooling
.pytest_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
.vscode/
